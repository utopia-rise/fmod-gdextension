# Paths starting with / are anchored at the repository root, so they never hide a folder of the same name elsewhere
# (gdUnit4 ships its runner in demo/addons/gdUnit4/bin/). The demo project, the addon and the Android plugin have their
# own .gitignore files; godot-cpp ignores its generated bindings itself.

### FMOD Studio API SDK (libs/<sdk platform>/, from an FMOD account; never committed) ###
/libs/*
!/libs/PUT_FMOD_LIBS_HERE_TO_BUILD

### SCons and godot-cpp ###
/bin/
/src/gen/
.sconsign*.dblite
.sconf_temp/
config.log
compile_commands.json

### C++ build outputs ###
*.o
*.os
*.obj
*.a
*.lib
*.exp
*.so
*.so.*
*.dylib
*.dll
*.pdb
*.ilk
*.idb
*.dSYM/

### CMake (CLion code model; CMakeLists.txt itself is tracked) ###
/cmake-build-*/
/build/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
_deps/

### IDEs and editors ###
.idea/
*.iml
*.iws
.vs/
.vscode/
*.sln
*.vcxproj*
*.suo
*.user
.cache/
.clangd/
*.swp
*~

### Python ###
__pycache__/
*.py[cod]
.venv/

### Operating systems ###
.DS_Store
Thumbs.db
desktop.ini

### Claude Code (only the shared skills are tracked) ###
/.claude/*
!/.claude/skills/
