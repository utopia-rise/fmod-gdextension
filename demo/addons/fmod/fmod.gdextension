[configuration]
author = "Utopia Rise - Pierre-Thomas Meisels (piiertho), Tristan Grespinet (CedNaru)"
entry_symbol = "fmod_library_init"
compatibility_minimum = 4.6
compatibility_maximum = "4"
reloadable = false
android_aar_plugin = true

[libraries]
windows.editor.x86_64 = "res://addons/fmod/libs/windows/x86_64/libGodotFmod.windows.editor.x86_64.dll"
windows.editor.arm64 = "res://addons/fmod/libs/windows/arm64/libGodotFmod.windows.editor.arm64.dll"
windows.debug.x86_64 = "res://addons/fmod/libs/windows/x86_64/libGodotFmod.windows.template_debug.x86_64.dll"
windows.debug.arm64 = "res://addons/fmod/libs/windows/arm64/libGodotFmod.windows.template_debug.arm64.dll"
windows.release.x86_64 = "res://addons/fmod/libs/windows/x86_64/libGodotFmod.windows.template_release.x86_64.dll"
windows.release.arm64 = "res://addons/fmod/libs/windows/arm64/libGodotFmod.windows.template_release.arm64.dll"
macos.editor = "res://addons/fmod/libs/macos/libGodotFmod.macos.editor.framework"
macos.debug  = "res://addons/fmod/libs/macos/libGodotFmod.macos.template_debug.framework"
macos.release  = "res://addons/fmod/libs/macos/libGodotFmod.macos.template_release.framework"
linux.editor.x86_64 = "res://addons/fmod/libs/linux/x86_64/libGodotFmod.linux.editor.x86_64.so"
linux.editor.arm64 = "res://addons/fmod/libs/linux/arm64/libGodotFmod.linux.editor.arm64.so"
linux.debug.x86_64 = "res://addons/fmod/libs/linux/x86_64/libGodotFmod.linux.template_debug.x86_64.so"
linux.debug.arm64 = "res://addons/fmod/libs/linux/arm64/libGodotFmod.linux.template_debug.arm64.so"
linux.release.x86_64 = "res://addons/fmod/libs/linux/x86_64/libGodotFmod.linux.template_release.x86_64.so"
linux.release.arm64 = "res://addons/fmod/libs/linux/arm64/libGodotFmod.linux.template_release.arm64.so"
android.debug.x86_64 = "res://addons/fmod/libs/android/x86_64/libGodotFmod.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/fmod/libs/android/x86_64/libGodotFmod.android.template_release.x86_64.so"
android.debug.arm64 = "res://addons/fmod/libs/android/arm64/libGodotFmod.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/fmod/libs/android/arm64/libGodotFmod.android.template_release.arm64.so"
ios.debug = "res://addons/fmod/libs/ios/libGodotFmod.ios.template_debug.xcframework"
ios.release = "res://addons/fmod/libs/ios/libGodotFmod.ios.template_release.xcframework"
web.debug.threads.wasm32 = "res://addons/fmod/libs/web/libGodotFmod.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://addons/fmod/libs/web/libGodotFmod.web.template_release.wasm32.wasm"
web.debug.wasm32 = "res://addons/fmod/libs/web/libGodotFmod.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://addons/fmod/libs/web/libGodotFmod.web.template_release.wasm32.nothreads.wasm"

[icons]
FmodEventEmitter2D = "res://addons/fmod/icons/fmod_event_emitter_2d.svg"
FmodEventEmitter3D = "res://addons/fmod/icons/fmod_event_emitter_3d.svg"
FmodListener2D = "res://addons/fmod/icons/audio_listener_2d.svg"
FmodListener3D = "res://addons/fmod/icons/audio_listener_3d.svg"
FmodBankLoader = "res://addons/fmod/icons/fmod_icon.svg"

